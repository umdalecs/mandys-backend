# Copy to `.env` and adjust: cp .env.example .env
# Compose reads `.env` automatically. Every variable below has a fallback
# default in the compose files, so `.env` is optional — it is for overrides.

# --- Shared development database -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mandys
# Host port published by the database service.
DB_PORT=5432

# --- Api (dotnet) ----------------------------------------------------------
# Host port the api is reachable on (container always listens on 8080).
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Where the api finds Postgres in api-only mode (`docker compose up`).
# Defaults to the shared dev database on the same Compose network (started
# via `docker compose -f compose.database.yml up -d database`). Point it at
# `host.docker.internal` (plus an `extra_hosts` entry) only if your database
# runs outside Compose on the host.
DB_HOST=database

# --- Secrets (production) --------------------------------------------------
# Not used by the dev compose setup (appsettings default applies). For
# production set a 32+ byte key via the environment, never commit it:
# Jwt__Key=change-me-to-a-32-plus-byte-secret
