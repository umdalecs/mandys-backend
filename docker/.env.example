# --- Development database -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mandys

DB_PORT=5432

# --- Api (dotnet) ----------------------------------------------------------
API_PORT=8080
DB_HOST=database

# --- pgAdmin 4  --------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mandys.com
PGADMIN_PASSWORD=postgres

# --- S3 Storage (RustFS) ---------------------------------------------------
S3_HOST=storage
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=mandys
S3_REGION=us-east-1

# --- Secrets (production) --------------------------------------------------
# Jwt__Key=change-me-to-a-32-plus-byte-secret
Jwt__ExpireMinutes=100

# --- Separately hosted frontend (Cloudflare Pages/Workers, any static host) --
FRONTEND_ORIGINS=https://mandys.pages.dev
COOKIE_SAMESITE=Lax
COOKIE_SECURE=Auto
