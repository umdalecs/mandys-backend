# --- Shared development database -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mandys

# Host port published by the database service.
DB_PORT=5432

# --- Api (dotnet) ----------------------------------------------------------
API_PORT=8080
DB_HOST=database

# --- pgAdmin 4 (optional, `tools` profile) --------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mandys.com
PGADMIN_PASSWORD=postgres

# --- Secrets (production) --------------------------------------------------
# Jwt__Key=change-me-to-a-32-plus-byte-secret
Jwt__ExpireMinutes=100

# --- Separately hosted frontend (Cloudflare Pages/Workers, any static host) --
FRONTEND_ORIGINS=https://mandys.pages.dev
COOKIE_SAMESITE=Lax
COOKIE_SECURE=Auto
