# Copy to `.env` and adjust (run from the repo root):
#   cp docker/.env.example docker/.env
# Compose reads `docker/.env` automatically when the compose files in this
# directory are used. Every variable below has a fallback
# default in the compose files, so `.env` is optional — it is for overrides.

# --- Shared development database -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mandys
# Host port published by the database service.
DB_PORT=5432

# --- Api (dotnet) ----------------------------------------------------------
# Host port the api is reachable on (container always listens on 8080).
API_PORT=8080
# The api always runs with ASPNETCORE_ENVIRONMENT=Development (set in
# compose.yml) so Scalar/OpenAPI are enabled. No override needed here.
# Where the api finds Postgres in api-only mode
# (`docker compose -f docker/compose.yml up` from the repo root).
# Defaults to the shared dev database on the same Compose network (started
# via `docker compose -f docker/compose.database.yml up -d database`). Point it at
# `host.docker.internal` (plus an `extra_hosts` entry) only if your database
# runs outside Compose on the host.
DB_HOST=database

# --- Secrets (production) --------------------------------------------------
# Not used by the dev compose setup (appsettings default applies). For
# production set a 32+ byte key via the environment, never commit it:
# Jwt__Key=change-me-to-a-32-plus-byte-secret

# --- Separately hosted frontend (Cloudflare Pages/Workers, any static host) --
# Public origin(s) of the frontend SPA, comma-separated. Enforced by CORS and
# the refresh/logout CSRF origin check. Empty keeps the localhost defaults.
FRONTEND_ORIGINS=https://mandys.pages.dev
# Cross-origin cookie policy. Same-site deployments keep Lax/Auto, but a
# frontend on another host needs None + Always (and the api behind HTTPS).
COOKIE_SAMESITE=Lax
COOKIE_SECURE=Auto
